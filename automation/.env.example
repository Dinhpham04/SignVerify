# Copy file này thành .env rồi điền — .env đã được gitignore, KHÔNG commit.

# --- VPS ---
VPS_HOST=221.132.21.204
VPS_USER=root
VPS_PORT=22
# Mật khẩu root: chỉ dùng một lần khi chạy install-key.sh.
# Lưu ở đây nếu cần, hoặc tốt hơn là trong trình quản lý mật khẩu.
VPS_ROOT_PASSWORD=
VPS_SSH_ALIAS=vps-automation

# --- Chữ ký số Automation ---
CHUKYSO_DOMAIN=chukyso.automation.info.vn
CHUKYSO_REMOTE_DIR=/opt/chukyso
FRONTEND_HTTP_PORT=3000
API_HTTP_PORT=5000

# --- InvestView Nginx ---
INVESTVIEW_DOMAIN=investview.automation.info.vn
WEB_HTTP_PORT=8080
# Set ISSUE_TLS=true only after DNS points to the VPS.
ISSUE_TLS=false
LETSENCRYPT_EMAIL=

# --- Cloudflare (xem 02-ket-noi-cloudflare.md) ---
# Token scoped: Zone:Read + DNS:Edit cho zone bên dưới.
CF_API_TOKEN=
# Tên miền (zone) trỏ về VPS này. Bắt buộc vì .info.vn là đuôi 2 cấp.
CF_ZONE=automation.info.vn

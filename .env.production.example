# Docker Compose production settings.
PUBLIC_ORIGIN=https://chukyso.automation.info.vn
FRONTEND_HTTP_PORT=3000
API_HTTP_PORT=5000

# Per-client upload rate limit enforced by the ASP.NET API.
RATE_LIMIT_PERMIT_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60

# Passwords for the public CA trust stores bundled in ./trust.
SIGNATURE_CHECK_TRUST_STORE_PASSWORD=changeit
SIGNATURE_CHECK_ADJUNCT_STORE_PASSWORD=changeit

# Revocation checks and network timeouts.
SIGNATURE_CHECK_REVOCATION_OCSP_ENABLED=true
SIGNATURE_CHECK_REVOCATION_CRL_ENABLED=true
SIGNATURE_CHECK_REVOCATION_FALLBACK_ENABLED=true
SIGNATURE_CHECK_REVOCATION_CACHE_ENABLED=true
SIGNATURE_CHECK_REVOCATION_TIMEOUT_CONNECTION_MILLIS=3000
SIGNATURE_CHECK_REVOCATION_TIMEOUT_CONNECTION_REQUEST_MILLIS=3000
SIGNATURE_CHECK_REVOCATION_TIMEOUT_RESPONSE_MILLIS=5000
SIGNATURE_CHECK_REVOCATION_TIMEOUT_SOCKET_MILLIS=5000
